<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0-android;net8.0-ios;net8.0-maccatalyst</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net8.0-windows10.0.19041.0</TargetFrameworks>
		<OutputType>Exe</OutputType>
		<RootNamespace>Raphael.Driver</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<NullabilityInfoContextSupport>true</NullabilityInfoContextSupport>
		
		<!-- Propiedades Generales -->
		<ApplicationTitle>Raphael.Driver</ApplicationTitle>
		<ApplicationId>com.raphael.driver</ApplicationId>
		<ApplicationDisplayVersion>1.5.0</ApplicationDisplayVersion>
		<ApplicationVersion>12</ApplicationVersion>
		<AssemblyVersion>1.2.0</AssemblyVersion>
		<FileVersion>1.2.0</FileVersion>

		<!--
		  Which server a build of this project is compiled for.

		  ⚠️ Declared ONCE, here, and always Prod. It is deliberately NOT varied by Debug and
		  Release: choosing the server by build configuration means nobody can ever test a
		  Release build against DEV, which is exactly what you want to do the day before
		  shipping one. Pointing a phone somewhere else is done from the sign-in screen —
		  seven taps on the version label, or #server as the username — and that works in any
		  build. (This said "long-press" until 2026-09-19. There has never been a long-press.)

		  The release gate (_meta/tools/Assert-ReleaseArtifact.ps1) refuses an APK whose csproj
		  declares anything but Prod here.
		-->
		<RaphaelApiEnvironment>Prod</RaphaelApiEnvironment>
	</PropertyGroup>

	<!--
	  Carries the value above into the binary, so that what the gate checks in the csproj is
	  the same thing ApiEnvironment reads at runtime. Without this the property would be a
	  claim nothing verifies.
	-->
	<ItemGroup>
		<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
			<_Parameter1>RaphaelApiEnvironment</_Parameter1>
			<_Parameter2>$(RaphaelApiEnvironment)</_Parameter2>
		</AssemblyAttribute>
	</ItemGroup>

	<!-- =================================================================== -->
	<!-- INICIO: CONFIGURACIÓN ESPECÍFICA PARA CADA PLATAFORMA (CORRECCIÓN) -->
	<!-- =================================================================== -->

	<!-- Configuración para Android -->
	<PropertyGroup Condition="'$(TargetFramework)'=='net8.0-android'">
		<!-- Versión mínima recomendada para estabilidad (Android 7.0) -->
		<SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
	</PropertyGroup>

	<!-- Configuración para iOS -->
	<PropertyGroup Condition="'$(TargetFramework)'=='net8.0-ios'">
		<SupportedOSPlatformVersion>11.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<!-- Configuración para Mac Catalyst -->
	<PropertyGroup Condition="'$(TargetFramework)'=='net8.0-maccatalyst'">
		<SupportedOSPlatformVersion>13.1</SupportedOSPlatformVersion>
	</PropertyGroup>

	<!-- Configuración para Windows -->
	<PropertyGroup Condition="'$(TargetFramework)'=='net8.0-windows10.0.19041.0'">
		<SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
		<!-- Propiedades de publicación de Windows movidas aquí -->
		<GenerateAppInstallerFile>True</GenerateAppInstallerFile>
		<AppxPackageSigningEnabled>True</AppxPackageSigningEnabled>
		<PackageCertificateThumbprint>4D41E47A4AF5B5C0BC95295E972B5A1D72FEFF17</PackageCertificateThumbprint>
		<AppxPackageSigningTimestampDigestAlgorithm>SHA256</AppxPackageSigningTimestampDigestAlgorithm>
		<AppxAutoIncrementPackageRevision>True</AppxAutoIncrementPackageRevision>
		<AppxSymbolPackageEnabled>False</AppxSymbolPackageEnabled>
		<GenerateTestArtifacts>True</GenerateTestArtifacts>
		<AppInstallerUri>E:\Instaladores</AppInstallerUri>
		<HoursBetweenUpdateChecks>0</HoursBetweenUpdateChecks>
	</PropertyGroup>

	<!-- =================================================================== -->
	<!-- FIN: CONFIGURACIÓN ESPECÍFICA PARA CADA PLATAFORMA -->
	<!-- =================================================================== -->

	<!-- =================================================================== -->
	<!-- INICIO: CONFIGURACIÓN DE PUBLICACIÓN (RELEASE) PARA ANDROID -->
	<!-- =================================================================== -->
	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net8.0-android|AnyCPU'">
		<!-- Esta propiedad FUERZA la generación de un .apk en lugar de un .aab -->
		<AndroidPackageFormat>apk</AndroidPackageFormat>
		<AndroidSigningV2Enabled>True</AndroidSigningV2Enabled>
		<AndroidSigningV3Enabled>True</AndroidSigningV3Enabled>
		<!-- ⚠️ This is the PropertyGroup that governs the distributed APK. It and the general
		     one are bumped together, or the tag says one thing and the app shows another.
		     ApplicationVersion is the Android versionCode: Google Play refuses an upload whose
		     versionCode is not strictly greater than the last one, so it only ever goes up,
		     never back, and never repeats — even for a build that is thrown away. -->
		<ApplicationDisplayVersion>1.5.0</ApplicationDisplayVersion>
		<ApplicationVersion>12</ApplicationVersion>

		<!-- Aquí irán las propiedades de firma que el asistente de publicación añade automáticamente -->
		<!-- Ejemplo: -->
		<!-- <AndroidSigningKeyStore>mi-keystore.keystore</AndroidSigningKeyStore> -->
		<!-- <AndroidSigningKeyAlias>mi_alias</AndroidSigningKeyAlias> -->
		<!-- <AndroidSigningKeyPass>mi_password</AndroidSigningKeyPass> -->
		<!-- <AndroidSigningStorePass>mi_password</AndroidSigningStorePass> -->
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net8.0-android|AnyCPU'">
	  <!-- Kept in step with Release so a phone under test reports the version it is actually
	       running. It never reaches a store, so its versionCode has nothing to collide with. -->
	  <ApplicationDisplayVersion>1.4.0</ApplicationDisplayVersion>
	  <ApplicationVersion>9</ApplicationVersion>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net8.0-ios|AnyCPU'">
	  <ApplicationDisplayVersion>1.1.0</ApplicationDisplayVersion>
	  <ApplicationVersion>1</ApplicationVersion>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net8.0-maccatalyst|AnyCPU'">
	  <ApplicationDisplayVersion>1.1.0</ApplicationDisplayVersion>
	  <ApplicationVersion>1</ApplicationVersion>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net8.0-windows10.0.19041.0|AnyCPU'">
	  <ApplicationDisplayVersion>1.1.0</ApplicationDisplayVersion>
	  <ApplicationVersion>1</ApplicationVersion>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net8.0-ios|AnyCPU'">
	  <ApplicationDisplayVersion>1.1.0</ApplicationDisplayVersion>
	  <ApplicationVersion>1</ApplicationVersion>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net8.0-maccatalyst|AnyCPU'">
	  <ApplicationDisplayVersion>1.1.0</ApplicationDisplayVersion>
	  <ApplicationVersion>1</ApplicationVersion>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net8.0-windows10.0.19041.0|AnyCPU'">
	  <ApplicationDisplayVersion>1.1.0</ApplicationDisplayVersion>
	  <ApplicationVersion>1</ApplicationVersion>
	</PropertyGroup>
	<!-- =================================================================== -->
	<!-- FIN: CONFIGURACIÓN DE PUBLICACIÓN (RELEASE) PARA ANDROID -->
	<!-- =================================================================== -->

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" Color="#FFFFFF" />
		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash_logo.svg" Color="#FFFFFF" BaseSize="300,375" />
		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />
		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />
		<!-- Raw Assets -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Maui" Version="8.0.1" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="9.0.4" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="9.0.4" />
		<PackageReference Include="Microsoft.Extensions.Http" Version="8.0.0" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="8.0.1" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<!-- Live in-app notifications: the /hubs/notifications SignalR hub -->
		<PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="8.0.11" />
	</ItemGroup>

	<!-- =================================================================== -->
	<!-- NOTIFICACIONES PUSH (Android) -->
	<!-- Firebase nativo en lugar de Plugin.Firebase: la app se distribuye -->
	<!-- como APK Android y el montaje de iOS/APNs hoy no existe. -->
	<!-- google-services.json sale del proyecto Firebase "raphael-nemt", -->
	<!-- el mismo que firma el backend. Sin él, el push no se entrega. -->
	<!-- =================================================================== -->
	<ItemGroup Condition="'$(TargetFramework)'=='net8.0-android'">
		<!-- ⚠️ Pinned to the 123.1.x line on purpose. From 123.2 onwards Firebase pulls the
		     AndroidX generation that merged the .ktx artifacts into their parents (Collection
		     1.4, Lifecycle 2.8), while .NET MAUI 8 still pins the split ones. Both ship
		     androidx/collection/ArrayMapKt.class and androidx/lifecycle/ViewModelKt.class, and
		     D8 stops with "type is defined multiple times". Raising this version means raising
		     AndroidX underneath MAUI, which is a much bigger bet than a newer FCM client. -->
		<PackageReference Include="Xamarin.Firebase.Messaging" Version="123.1.2.2" />

		<GoogleServicesJson Include="Platforms\Android\google-services.json" Condition="Exists('Platforms\Android\google-services.json')" />
	</ItemGroup>

	<!-- Se eliminaron los ItemGroup duplicados e innecesarios para MauiFont y MauiImage -->

