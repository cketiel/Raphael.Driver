<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!--
      Colours that are the same in every theme. Anything that changes with the theme lives in
      LightTheme / GrayTheme / DarkTheme / InfraredTheme.xaml, all four with the same keys, and
      ThemeManager merges exactly one of them after this file.

      ⚠️ A key read with StaticResource must exist when the page is built, or the app closes at
      runtime while the build stays green. App.xaml merges LightTheme so every themed key exists
      from the first instant; ThemeManager replaces it before the Shell is created.
    -->

    <!-- Neutrals -->
    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="OffBlack">#1F1F1F</Color>
    <Color x:Key="AppDarkBackgroundColor">#1C1C1E</Color>
    <Color x:Key="PrimaryDarkText">#1A1A1A</Color>
    <Color x:Key="SecondaryDarkText">#F44336</Color>

    <!-- Greys -->
    <Color x:Key="Gray100">#F5F5F5</Color>
    <Color x:Key="Gray200">#EEEEEE</Color>
    <Color x:Key="Gray300">#E0E0E0</Color>
    <Color x:Key="Gray400">#BDBDBD</Color>
    <Color x:Key="Gray500">#9E9E9E</Color>
    <Color x:Key="Gray600">#757575</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#121212</Color>

    <!--
      The signature pad stays white with black ink in every theme. The image the driver signs is
      saved as it is drawn, on a white background (SignatureViewModel), and goes to the funding
      source: light ink on a dark theme would save as a blank signature.
    -->
    <Color x:Key="SignaturePadColor">White</Color>
    <Color x:Key="SignatureInkColor">Black</Color>

    <!-- Theme switcher dots: each one shows the theme it selects, so they never change. -->
    <Color x:Key="SwatchLightColor">#FFFFFF</Color>
    <Color x:Key="SwatchGrayColor">#A9B4BB</Color>
    <Color x:Key="SwatchDarkColor">#16222A</Color>
    <Color x:Key="SwatchInfraredColor">#B3261E</Color>

</ResourceDictionary>
