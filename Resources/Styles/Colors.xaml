<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Raphael Theme-->

    <Color x:Key="AppDarkBackgroundColor">#1C1C1E</Color>
    
    <!-- Colores primarios en tonalidades de rojo -->
    <Color x:Key="Primary">#D32F2F</Color>
    <!-- Rojo principal -->
    <Color x:Key="PrimaryDark">#9A0007</Color>
    <!-- Rojo más oscuro -->
    <Color x:Key="PrimaryDarkText">#1A1A1A</Color>
    <!-- Texto oscuro para fondo rojo -->
    
    
    <Color x:Key="Secondary">#FFCDD2</Color>
    <!-- Rojo claro pastel -->
    <Color x:Key="SecondaryDarkText">#F44336</Color>
    <!-- Texto sobre fondo claro -->

    <Color x:Key="Tertiary">#C62828</Color>
    <!-- Rojo alternativo para énfasis -->

    <!-- Neutros -->
    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="OffBlack">#1F1F1F</Color>

    <!-- Grises -->
    <Color x:Key="Gray100">#F5F5F5</Color>
    <Color x:Key="Gray200">#EEEEEE</Color>
    <Color x:Key="Gray300">#E0E0E0</Color>
    <Color x:Key="Gray400">#BDBDBD</Color>
    <Color x:Key="Gray500">#9E9E9E</Color>
    <Color x:Key="Gray600">#757575</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#121212</Color>

    <!-- Brushes para uso directo -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>

    <!-- COLORES PARA EL TEMA CLARO (LIGHT THEME) -->

    <!-- Colores de Fondo -->
    <Color x:Key="PageBackgroundColor">#F0F0F0</Color>
    <Color x:Key="CardBackgroundColor">White</Color>
    <Color x:Key="PrimaryColor">#B82E49</Color>

    <!--
      ⚠️ Global on purpose, and it was not always. It lived inside LoginPage.xaml's own
      resource dictionary, so AppShell.xaml referencing it resolved to nothing and threw while
      the Shell was being built — the app closed the instant it was opened, on every launch.
      The build did not catch it: a StaticResource that cannot be found is a runtime failure,
      and the project compiled green. Anything used by more than one page belongs here.
    -->
    <Color x:Key="AccentColorRed">#FF6B6B</Color>

    <!-- Colores de Texto -->
    <Color x:Key="PrimaryTextColor">Black</Color>
    <Color x:Key="SecondaryTextColor">Gray</Color>
    <Color x:Key="TertiaryTextColor">#1E90FF</Color>
    <!-- Para links o textos especiales -->
    <Color x:Key="ButtonTextColor">White</Color>

    <!-- Colores de Separadores y Bordes -->
    <Color x:Key="SeparatorColor">#E0E0E0</Color>
    <Color x:Key="BorderColor">#CCCCCC</Color>
    
    
