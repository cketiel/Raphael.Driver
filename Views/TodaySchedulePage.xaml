<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:viewmodels="clr-namespace:Raphael.Driver.ViewModels"
             xmlns:dto="clr-namespace:Raphael.Driver.DTOs"
             xmlns:converters="clr-namespace:Raphael.Driver.Converters"
             x:Class="Raphael.Driver.Views.TodaySchedulePage"
             xmlns:controls="clr-namespace:Raphael.Driver.Controls"
             xmlns:cards="clr-namespace:Raphael.Driver.Controls.ScheduleCards"
             x:DataType="viewmodels:TodayScheduleViewModel"
             Title="TODAY' SCHEDULE">

    <Shell.TitleView>
        <!--
            The bell belongs here above all. This is where the driver spends the shift, so a
            page without it is a driver who never learns a notification arrived.
        -->
        <controls:PageTitleBar Title="TODAY'S SCHEDULE" Icon="&#xf783;" />
    </Shell.TitleView>

    <ContentPage.Behaviors>
        <!-- No StatusBarBehavior: the status bar follows the theme (ThemeManager.ApplyStatusBar). -->
    </ContentPage.Behaviors>

    <ContentPage.Resources>
        <converters:ScheduleColorConverter x:Key="ScheduleColorConverter" />
        <converters:ScheduleDisplayTimeConverter x:Key="ScheduleDisplayTimeConverter" />
        <converters:ScheduleTimeLabelConverter x:Key="ScheduleTimeLabelConverter" />
        <converters:ScheduleRotationConverter x:Key="ScheduleRotationConverter" />
        <converters:ScheduleArrowConverter x:Key="ScheduleArrowConverter" />
        <converters:TripTypeConverter x:Key="TripTypeConverter" />

        <converters:TimeSpanToDateTimeConverter x:Key="TimeSpanToDateTimeConverter" />

        <Style TargetType="Label" x:Key="IconLabel">
            <Setter Property="FontFamily" Value="FontAwesomeSolid" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="TextColor" Value="{DynamicResource InkColor}" />
            <Setter Property="VerticalOptions" Value="Center" />
            <Setter Property="WidthRequest" Value="25"/>
        </Style>
    </ContentPage.Resources>

    <!--
        A grid only so the Call me button floats over the list without being part of it: inside
        the RefreshView it would move with the pull-to-refresh gesture.
    -->
    <Grid>

    <!-- We use a RefreshView to enable reloading and handle the loading indicator -->
    <RefreshView Command="{Binding LoadEventsCommand}" IsRefreshing="{Binding IsBusy}">

        <Grid RowDefinitions="Auto, *" RowSpacing="10" BackgroundColor="{DynamicResource PageBackgroundColor}">
          
            <Grid Grid.Row="0" ColumnDefinitions="*,*" ColumnSpacing="10" Padding="10,10">
                <Button Text="VIEW HISTORY" Style="{StaticResource SecondaryButtonStyle}" CornerRadius="8" Command="{Binding GoToHistoryCommand}" IsEnabled="{Binding IsHistoryAvailable}"/>
                <Button Grid.Column="1" Text="CHANGE ROUTE" Style="{StaticResource TertiaryButtonStyle}" CornerRadius="8" Command="{Binding ChangeRouteCommand}"/>
            </Grid>
           
            <Grid Grid.Row="1">
              
                <CollectionView x:Name="EventsList" ItemsSource="{Binding Events}"
                                SelectionMode="None"
                                IsVisible="{Binding HasEvents}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="dto:ScheduleDto">

                            <!-- The card in the driver's schedule style (Settings → SCHEDULE STYLE);
                                 Legacy is the card this template used to hold, unchanged. -->
                            <cards:EventCardView Event="{Binding .}">
                                <cards:EventCardView.GestureRecognizers>
                                    <TapGestureRecognizer 
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:TodayScheduleViewModel}}, Path=SelectEventCommand}"
                                        CommandParameter="{Binding .}" />
                                </cards:EventCardView.GestureRecognizers>
                            </cards:EventCardView>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                    <!-- Room to scroll the last trip out from under the Call me button. -->
                    <CollectionView.Footer>
                        <BoxView HeightRequest="96" Color="Transparent" />
                    </CollectionView.Footer>
                </CollectionView>


                <Label Text="No trips to show."
                       IsVisible="{Binding ShowNoEventsMessage}"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       HorizontalTextAlignment="Center"
                       Margin="40,0"
                       TextColor="{DynamicResource SecondaryTextColor}"
                       FontSize="18"/>

                <!-- The ActivityIndicator is no longer needed here, the RefreshView takes care of it. -->
                
            </Grid>
        </Grid>
    </RefreshView>

    <!-- The page the shift is spent on, so the one that explains the button the first time. -->
    <controls:CallRequestButton VehicleRouteId="{Binding VehicleRouteId}"
                                ShowIntro="True" />

    </Grid>
</ContentPage>