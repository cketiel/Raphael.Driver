<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Raphael.Driver.Views.LoginPage"
             xmlns:viewmodels="clr-namespace:Raphael.Driver.ViewModels"
             xmlns:converters="clr-namespace:Raphael.Driver.Converters"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False">

    <ContentPage.BindingContext>
        <viewmodels:LoginViewModel />
    </ContentPage.BindingContext>

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
            <converters:StringToBoolConverter x:Key="StringToBoolConverter" />

            <Color x:Key="PageBackgroundColorStart">#E94560</Color>

            <Color x:Key="PageBackgroundColorEnd">#B82E49</Color>

            <Color x:Key="FormContainerColor">#6A0000</Color>

            <Color x:Key="FormContainerBackgroundColor">#A06A0000</Color>

            <Color x:Key="EntryBackgroundColor">#80400000</Color>

            <Color x:Key="LoginButtonColor">#A52A2A</Color>

            <Color x:Key="PrimaryTextColor">White</Color>
            <Color x:Key="SecondaryTextColor">#FFE0E0</Color>

            <Color x:Key="PlaceholderColor">#FFC0C0</Color>

            <!-- AccentColorRed moved to Resources/Styles/Colors.xaml: the flyout needs it too,
                 and a page-level copy is invisible to everything outside this page. -->

            <Style TargetType="Label" x:Key="IconLabelStyle">
                <Setter Property="FontFamily" Value="FontAwesomeSolid" />
                <Setter Property="FontSize" Value="18" />
                <Setter Property="VerticalTextAlignment" Value="Center" />
                <Setter Property="HorizontalTextAlignment" Value="Center" />
                <Setter Property="TextColor" Value="{StaticResource PrimaryTextColor}" />
                <Setter Property="Margin" Value="0,0,5,0"/>
            </Style>

            <Style TargetType="Entry">
                <Setter Property="TextColor" Value="{StaticResource PrimaryTextColor}" />
                <Setter Property="PlaceholderColor" Value="{StaticResource PlaceholderColor}" />
                <Setter Property="BackgroundColor" Value="Transparent"/>
                <Setter Property="VerticalTextAlignment" Value="Center"/>
                <Setter Property="HeightRequest" Value="50"/>
                <Setter Property="FontSize" Value="16"/>
            </Style>

            <Style TargetType="Button" x:Key="LinkButton">
                <Setter Property="TextColor" Value="{StaticResource PrimaryTextColor}"/>
                <Setter Property="BackgroundColor" Value="Transparent"/>
                <Setter Property="FontSize" Value="Small"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="FontAttributes" Value="None"/>
                <!-- <Setter Property="TextDecorations" Value="Underline"/> Opcional -->
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="{StaticResource PageBackgroundColorStart}" Offset="0.0" />
                <GradientStop Color="{StaticResource PageBackgroundColorEnd}" Offset="1.0" />
            </LinearGradientBrush>
        </Grid.Background>

        <ScrollView>

            <VerticalStackLayout Padding="30,0"
                                 Spacing="5"
                                 VerticalOptions="Center"
                                 HorizontalOptions="FillAndExpand">

                <!--<Label Text="Sign In"
                       TextColor="{StaticResource PrimaryTextColor}"
                       FontSize="36"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       Margin="0,40,0,20"/>-->

                <Image Source="logo.png"
                       Aspect="AspectFit"
                       WidthRequest="200"
                       HeightRequest="200"/>

                <Label Text="RAPHAEL"
                       TextColor="{StaticResource FormContainerColor}"
                       FontSize="12"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       Margin="0,-50,0,20"/>

                <Label Text="by Milanes Service LLC"
                       TextColor="{StaticResource PrimaryTextColor}"
                       FontSize="12"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       Margin="0,-20,0,20"/>

                <Border BackgroundColor="{StaticResource FormContainerBackgroundColor}"
                        StrokeThickness="0"
                        Padding="25"
                        StrokeShape="RoundRectangle 20"
                        HorizontalOptions="FillAndExpand"
                        Margin="10,0">

                    <VerticalStackLayout Spacing="20">

                        <!-- Username Entry -->
                        <Border BackgroundColor="{StaticResource EntryBackgroundColor}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 25"
                                Padding="15,0,10,0"
                                HeightRequest="50">

                            <Grid ColumnDefinitions="Auto,*"
                                  ColumnSpacing="10">

                                <Label Text=""
                                       Style="{StaticResource IconLabelStyle}" />
                                <!-- fa-user -->

                                <Entry Grid.Column="1"
                                       Placeholder="Username"
                                       Text="{Binding Username}"/>

                            </Grid>

                        </Border>

                        <!-- Password Entry -->
                        <Border BackgroundColor="{StaticResource EntryBackgroundColor}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 25"
                                Padding="15,0,10,0"
                                HeightRequest="50">

                            <Grid ColumnDefinitions="Auto,*,Auto"
                                  ColumnSpacing="10">

                                <Label Text=""
                                       Style="{StaticResource IconLabelStyle}" />
                                <!-- fa-lock -->

                                <Entry Grid.Column="1"
                                       Placeholder="Password"
                                       Text="{Binding Password}"
                                       IsPassword="{Binding IsPasswordMasked}" />

                                <Button Grid.Column="2"
                                        Text="{Binding PasswordToggleIcon}"
                                        FontFamily="FontAwesomeSolid"
                                        FontSize="20"
                                        Command="{Binding TogglePasswordMaskCommand}"
                                        BackgroundColor="Transparent"
                                        TextColor="{StaticResource PrimaryTextColor}"
                                        Padding="5"
                                        WidthRequest="40"
                                        BorderColor="Transparent"
                                        BorderWidth="0"
                                        VerticalOptions="Center"/>

                            </Grid>

                        </Border>

                        <Grid ColumnDefinitions="Auto,*"
                              ColumnSpacing="5"
                              Margin="0,5,0,0">

                            <CheckBox IsChecked="{Binding RememberMe}" />

                            <Label Grid.Column="1"
                                   Text="Remember me"
                                   TextColor="{StaticResource SecondaryTextColor}"
                                   VerticalTextAlignment="Center"
                                   FontSize="Small"/>

                        </Grid>

                        <Button Text="Log In"
                                Command="{Binding LoginCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                                BackgroundColor="{StaticResource LoginButtonColor}"
                                TextColor="{StaticResource PrimaryTextColor}"
                                HeightRequest="50"
                                CornerRadius="25"
                                FontSize="24"
                                FontAttributes="Bold"
                                Margin="0,10,0,0"/>

                        <ActivityIndicator IsRunning="{Binding IsBusy}"
                                           IsVisible="{Binding IsBusy}"
                                           Color="{StaticResource PrimaryTextColor}"
                                           HorizontalOptions="Center"
                                           Margin="0,10,0,0"/>

                        <Label Text="{Binding ErrorMessage}"
                               TextColor="{StaticResource AccentColorRed}"
                               HorizontalOptions="Center"
                               Margin="0,5,0,0"
                               IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}"/>

                    </VerticalStackLayout>

                </Border>

                <HorizontalStackLayout Spacing="5"
                                       HorizontalOptions="Center"
                                       Margin="0,25,0,5">

                    <Label Text="RAPHAEL by"
                           TextColor="{StaticResource SecondaryTextColor}"
                           VerticalTextAlignment="Center"/>

                    <Button Text="MILANES System"
                            Command="{Binding GoToMilanesPageCommand}"
                            Style="{StaticResource LinkButton}"
                            TextColor="{StaticResource AccentColorRed}"
                            FontAttributes="Bold"/>

                </HorizontalStackLayout>

                <!--
                    Application version, and one of the two ways in to the server dialog.

                    Seven taps here opens it. It has to be on THIS page: the Settings page is
                    behind the sign-in, and signing in is what needs a server address, so a
                    phone pointed at the wrong one could not be fixed from inside the app.
                    Seven taps rather than a button so a driver never finds it by accident.

                    The other way is typing #server as the username and pressing Sign in,
                    which is the one support can dictate down a telephone in one sentence.
                    See LoginViewModel.Login.
                -->
                <Label Text="{Binding Version}"
                       TextColor="{StaticResource SecondaryTextColor}"
                       FontSize="11"
                       HorizontalOptions="Center"
                       Margin="0,0,0,4">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding TapVersionCommand}"/>
                    </Label.GestureRecognizers>
                </Label>

                <!-- How many taps are left, once the run is clearly deliberate. Without it
                     the count is invisible and a driver who miscounts cannot tell whether
                     they are one tap away or back at zero. -->
                <Label Text="{Binding TapHint}"
                       IsVisible="{Binding ShowTapHint}"
                       TextColor="{StaticResource SecondaryTextColor}"
                       FontSize="11"
                       HorizontalOptions="Center"
                       Margin="0,0,0,4"/>

                <!-- Empty unless this build is pointed somewhere other than production. -->
                <Label Text="{Binding EnvironmentBanner}"
                       IsVisible="{Binding ShowEnvironmentBanner}"
                       TextColor="{StaticResource AccentColorRed}"
                       FontAttributes="Bold"
                       FontSize="11"
                       HorizontalOptions="Center"
                       Margin="0,0,0,15"/>

            </VerticalStackLayout>

        </ScrollView>

    </Grid>

</ContentPage>