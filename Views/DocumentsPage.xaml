<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Raphael.Driver.ViewModels"
             xmlns:controls="clr-namespace:Raphael.Driver.Controls"
             xmlns:converters="clr-namespace:Raphael.Driver.Converters"
             x:Class="Raphael.Driver.Views.DocumentsPage"
             x:DataType="viewmodels:DocumentsViewModel"
             BackgroundColor="{DynamicResource PageBackgroundColor}">

    <Shell.TitleView>
        <controls:PageTitleBar Title="MY DOCUMENTS" Icon="&#xf15c;" ShowBell="False" />
    </Shell.TitleView>

    <!--
        RE-065. A header with whose documents they are and three counters, two tabs (the driver's
        own and the vehicle's) with a badge of what needs them, and a card per document: a stripe
        and a chip in the colour of its state, what the file is (PDF, image, 5 photos) and how much
        of the year is left.

        ⚠️ Every state colour comes from the State* styles below, one DataTrigger per state and no
        local value: leaving a trigger, MAUI drops every DynamicResource it set (see SettingsPage).
    -->
    <ContentPage.Resources>
        <converters:IsNotNullConverter x:Key="IsNotNullConverter" />
        <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />

        <Style TargetType="BoxView" x:Key="StateStripe">
            <Style.Triggers>
                <DataTrigger TargetType="BoxView" Binding="{Binding State}" x:DataType="{x:Null}" Value="valid"><Setter Property="Color" Value="{DynamicResource OkColor}" /></DataTrigger>
                <DataTrigger TargetType="BoxView" Binding="{Binding State}" x:DataType="{x:Null}" Value="soon"><Setter Property="Color" Value="{DynamicResource WarnColor}" /></DataTrigger>
                <DataTrigger TargetType="BoxView" Binding="{Binding State}" x:DataType="{x:Null}" Value="pending"><Setter Property="Color" Value="{DynamicResource AccentColor}" /></DataTrigger>
                <DataTrigger TargetType="BoxView" Binding="{Binding State}" x:DataType="{x:Null}" Value="expired"><Setter Property="Color" Value="{DynamicResource DangerColor}" /></DataTrigger>
                <DataTrigger TargetType="BoxView" Binding="{Binding State}" x:DataType="{x:Null}" Value="rejected"><Setter Property="Color" Value="{DynamicResource DangerColor}" /></DataTrigger>
                <DataTrigger TargetType="BoxView" Binding="{Binding State}" x:DataType="{x:Null}" Value="missing"><Setter Property="Color" Value="{DynamicResource BorderColor}" /></DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Border" x:Key="StateSoft">
            <Style.Triggers>
                <DataTrigger TargetType="Border" Binding="{Binding State}" x:DataType="{x:Null}" Value="valid"><Setter Property="BackgroundColor" Value="{DynamicResource OkSoftColor}" /></DataTrigger>
                <DataTrigger TargetType="Border" Binding="{Binding State}" x:DataType="{x:Null}" Value="soon"><Setter Property="BackgroundColor" Value="{DynamicResource WarnSoftColor}" /></DataTrigger>
                <DataTrigger TargetType="Border" Binding="{Binding State}" x:DataType="{x:Null}" Value="pending"><Setter Property="BackgroundColor" Value="{DynamicResource AccentSoftColor}" /></DataTrigger>
                <DataTrigger TargetType="Border" Binding="{Binding State}" x:DataType="{x:Null}" Value="expired"><Setter Property="BackgroundColor" Value="{DynamicResource DangerSoftColor}" /></DataTrigger>
                <DataTrigger TargetType="Border" Binding="{Binding State}" x:DataType="{x:Null}" Value="rejected"><Setter Property="BackgroundColor" Value="{DynamicResource DangerSoftColor}" /></DataTrigger>
                <DataTrigger TargetType="Border" Binding="{Binding State}" x:DataType="{x:Null}" Value="missing"><Setter Property="BackgroundColor" Value="{DynamicResource SurfaceColor}" /></DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Label" x:Key="StateInk">
            <Style.Triggers>
                <DataTrigger TargetType="Label" Binding="{Binding State}" x:DataType="{x:Null}" Value="valid"><Setter Property="TextColor" Value="{DynamicResource OkColor}" /></DataTrigger>
                <DataTrigger TargetType="Label" Binding="{Binding State}" x:DataType="{x:Null}" Value="soon"><Setter Property="TextColor" Value="{DynamicResource WarnColor}" /></DataTrigger>
                <DataTrigger TargetType="Label" Binding="{Binding State}" x:DataType="{x:Null}" Value="pending"><Setter Property="TextColor" Value="{DynamicResource AccentColor}" /></DataTrigger>
                <DataTrigger TargetType="Label" Binding="{Binding State}" x:DataType="{x:Null}" Value="expired"><Setter Property="TextColor" Value="{DynamicResource DangerTextColor}" /></DataTrigger>
                <DataTrigger TargetType="Label" Binding="{Binding State}" x:DataType="{x:Null}" Value="rejected"><Setter Property="TextColor" Value="{DynamicResource DangerTextColor}" /></DataTrigger>
                <DataTrigger TargetType="Label" Binding="{Binding State}" x:DataType="{x:Null}" Value="missing"><Setter Property="TextColor" Value="{DynamicResource SecondaryTextColor}" /></DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ProgressBar" x:Key="StateBar">
            <Style.Triggers>
                <DataTrigger TargetType="ProgressBar" Binding="{Binding State}" x:DataType="{x:Null}" Value="valid"><Setter Property="ProgressColor" Value="{DynamicResource OkColor}" /></DataTrigger>
                <DataTrigger TargetType="ProgressBar" Binding="{Binding State}" x:DataType="{x:Null}" Value="soon"><Setter Property="ProgressColor" Value="{DynamicResource WarnColor}" /></DataTrigger>
                <DataTrigger TargetType="ProgressBar" Binding="{Binding State}" x:DataType="{x:Null}" Value="pending"><Setter Property="ProgressColor" Value="{DynamicResource AccentColor}" /></DataTrigger>
                <DataTrigger TargetType="ProgressBar" Binding="{Binding State}" x:DataType="{x:Null}" Value="expired"><Setter Property="ProgressColor" Value="{DynamicResource DangerColor}" /></DataTrigger>
                <DataTrigger TargetType="ProgressBar" Binding="{Binding State}" x:DataType="{x:Null}" Value="rejected"><Setter Property="ProgressColor" Value="{DynamicResource DangerColor}" /></DataTrigger>
                <DataTrigger TargetType="ProgressBar" Binding="{Binding State}" x:DataType="{x:Null}" Value="missing"><Setter Property="ProgressColor" Value="{DynamicResource BorderColor}" /></DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Label" x:Key="Glyph">
            <Setter Property="FontFamily" Value="FontAwesomeSolid" />
            <Setter Property="VerticalOptions" Value="Center" />
            <Setter Property="HorizontalOptions" Value="Center" />
        </Style>
        <Style TargetType="Label" x:Key="StatNumber">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="HorizontalOptions" Value="Center" />
        </Style>
        <Style TargetType="Label" x:Key="StatCaption">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="CharacterSpacing" Value="0.6" />
            <Setter Property="HorizontalOptions" Value="Center" />
            <Setter Property="TextColor" Value="{DynamicResource SecondaryTextColor}" />
        </Style>
        <Style TargetType="Label" x:Key="Caption">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="CharacterSpacing" Value="0.8" />
            <Setter Property="TextColor" Value="{DynamicResource TertiaryTextColor}" />
        </Style>
        <Style TargetType="Border" x:Key="Shadowed">
            <Setter Property="Shadow">
                <Shadow Brush="Black" Opacity="0.08" Radius="10" Offset="0,3" />
            </Setter>
        </Style>
    </ContentPage.Resources>

    <RefreshView Command="{Binding LoadCommand}" IsRefreshing="{Binding IsBusy}">
        <CollectionView ItemsSource="{Binding Rows}" SelectionMode="None">

            <CollectionView.Header>
                <VerticalStackLayout Spacing="14" Padding="16,14,16,4">

                    <!--
                        Who, then whose the counters are: the driver at the top, and under it the tab
                        on screen (My documents, or the vehicle's) with its three counters.
                    -->
                    <Border Padding="0" StrokeThickness="1" StrokeShape="RoundRectangle 20" Style="{StaticResource Shadowed}"
                            BackgroundColor="{DynamicResource CardBackgroundColor}" Stroke="{DynamicResource SeparatorColor}">
                        <VerticalStackLayout>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" Padding="16,16,16,14" BackgroundColor="{DynamicResource TintColor}">
                                <Border WidthRequest="52" HeightRequest="52" StrokeThickness="0" StrokeShape="RoundRectangle 26"
                                        BackgroundColor="{DynamicResource AccentColor}">
                                    <Label Text="{Binding Initials}" FontSize="19" FontAttributes="Bold"
                                           HorizontalOptions="Center" VerticalOptions="Center" TextColor="{DynamicResource CardBackgroundColor}" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label Text="{Binding DriverName}" FontSize="18" FontAttributes="Bold"
                                           TextColor="{DynamicResource InkColor}" LineBreakMode="TailTruncation" />
                                    <Label FontSize="13" TextColor="{DynamicResource SecondaryTextColor}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="&#xf007;  " FontFamily="FontAwesomeSolid" FontSize="11" />
                                                <Span Text="{Binding Username}" />
                                                <Span Text="  ·  Driver" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </VerticalStackLayout>
                            </Grid>

                            <VerticalStackLayout Padding="16,14,16,16" Spacing="12">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                    <Label Text="{Binding SummaryGlyph}" Style="{StaticResource Glyph}" FontSize="15" TextColor="{DynamicResource AccentColor}" />
                                    <Label Grid.Column="1" Text="{Binding SummaryTitle}" FontSize="15" FontAttributes="Bold"
                                           TextColor="{DynamicResource InkColor}" VerticalOptions="Center" LineBreakMode="TailTruncation" />
                                    <Label Grid.Column="2" FontSize="12.5" TextColor="{DynamicResource SecondaryTextColor}" VerticalOptions="Center">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding TotalCount}" FontAttributes="Bold" />
                                                <Span Text=" documents" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </Grid>
                                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                    <Border Padding="6,10" StrokeThickness="0" StrokeShape="RoundRectangle 14" BackgroundColor="{DynamicResource OkSoftColor}">
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="{Binding ValidCount}" Style="{StaticResource StatNumber}" TextColor="{DynamicResource OkColor}" />
                                            <Label Text="VALID" Style="{StaticResource StatCaption}" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <Border Grid.Column="1" Padding="6,10" StrokeThickness="0" StrokeShape="RoundRectangle 14" BackgroundColor="{DynamicResource WarnSoftColor}">
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="{Binding AttentionCount}" Style="{StaticResource StatNumber}" TextColor="{DynamicResource WarnColor}" />
                                            <Label Text="NEED YOU" Style="{StaticResource StatCaption}" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <Border Grid.Column="2" Padding="6,10" StrokeThickness="0" StrokeShape="RoundRectangle 14" BackgroundColor="{DynamicResource AccentSoftColor}">
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="{Binding ReviewCount}" Style="{StaticResource StatNumber}" TextColor="{DynamicResource AccentColor}" />
                                            <Label Text="IN REVIEW" Style="{StaticResource StatCaption}" />
                                        </VerticalStackLayout>
                                    </Border>
                                </Grid>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- The tabs: the same as the schedule's, with a count of what needs the driver. -->
                    <controls:SegmentedTabs Items="me|&#xf2c2;|Mine;vehicle|&#xf5e4;|Vehicle"
                                            Selected="{Binding Tab, Mode=TwoWay}"
                                            Badge0="{Binding MeAttention}" Badge1="{Binding VehicleAttention}" />

                    <Label Text="{Binding SubjectLine}" FontSize="13" TextColor="{DynamicResource SecondaryTextColor}" Margin="4,0" />
                    <Label Text="{Binding Error}" IsVisible="{Binding Error, Converter={StaticResource IsNotNullConverter}}"
                           FontSize="14" TextColor="{DynamicResource DangerTextColor}" Margin="4,0" />
                </VerticalStackLayout>
            </CollectionView.Header>

            <CollectionView.EmptyView>
                <VerticalStackLayout Spacing="12" Margin="30,40" IsVisible="{Binding HasVehicle, Converter={StaticResource InvertedBoolConverter}}">
                    <Label Text="&#xf5e4;" Style="{StaticResource Glyph}" FontSize="40" TextColor="{DynamicResource TertiaryTextColor}" />
                    <Label Text="No vehicle on your route today. Its documents show here once you have one."
                           HorizontalTextAlignment="Center" FontSize="15" TextColor="{DynamicResource SecondaryTextColor}" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="viewmodels:ComplianceRow">
                    <Border Margin="16,0,16,14" Padding="0" StrokeThickness="1" StrokeShape="RoundRectangle 18" Style="{StaticResource Shadowed}"
                            BackgroundColor="{DynamicResource CardBackgroundColor}" Stroke="{DynamicResource SeparatorColor}">
                        <Grid RowDefinitions="4,Auto">
                            <!-- The state, as a band across the top. -->
                            <BoxView Style="{StaticResource StateStripe}" />

                            <VerticalStackLayout Grid.Row="1" Padding="16,14,16,14" Spacing="12">

                                <!-- Icon, name and kind, state chip. -->
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Border WidthRequest="48" HeightRequest="48" StrokeThickness="0" StrokeShape="RoundRectangle 14"
                                            Style="{StaticResource StateSoft}">
                                        <Label Text="{Binding Glyph}" Style="{StaticResource StateInk}" FontFamily="FontAwesomeSolid" FontSize="19"
                                               HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                        <Label Text="{Binding Name}" FontSize="16.5" FontAttributes="Bold" TextColor="{DynamicResource InkColor}" />
                                        <Label Text="{Binding Kind}" FontSize="12.5" TextColor="{DynamicResource SecondaryTextColor}" />
                                    </VerticalStackLayout>
                                    <Border Grid.Column="2" Padding="9,5" StrokeThickness="0" StrokeShape="RoundRectangle 12"
                                            VerticalOptions="Start" Style="{StaticResource StateSoft}">
                                        <HorizontalStackLayout Spacing="5">
                                            <Label Text="{Binding StateGlyph}" Style="{StaticResource StateInk}" FontFamily="FontAwesomeSolid" FontSize="11" VerticalOptions="Center" />
                                            <Label Text="{Binding StateText}" Style="{StaticResource StateInk}" FontSize="11.5" FontAttributes="Bold" VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                    </Border>
                                </Grid>

                                <!-- File and expiry, side by side. -->
                                <Border Padding="14,10" StrokeThickness="0" StrokeShape="RoundRectangle 12" BackgroundColor="{DynamicResource SurfaceColor}">
                                    <Grid ColumnDefinitions="*,1,*" ColumnSpacing="14">
                                        <VerticalStackLayout Spacing="4">
                                            <Label Text="FILE" Style="{StaticResource Caption}" />
                                            <HorizontalStackLayout Spacing="7">
                                                <Label Text="{Binding FileGlyph}" Style="{StaticResource Glyph}" FontSize="16" TextColor="{DynamicResource AccentColor}" />
                                                <Label Text="{Binding FileLabel}" FontSize="13.5" FontAttributes="Bold" TextColor="{DynamicResource InkColor}" VerticalOptions="Center" />
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>
                                        <BoxView Grid.Column="1" Color="{DynamicResource SeparatorColor}" />
                                        <VerticalStackLayout Grid.Column="2" Spacing="4">
                                            <Label Text="{Binding ExpiryCaption}" Style="{StaticResource Caption}" />
                                            <HorizontalStackLayout Spacing="7">
                                                <Label Text="&#xf133;" Style="{StaticResource Glyph}" FontSize="14" TextColor="{DynamicResource AccentColor}" />
                                                <Label Text="{Binding ExpiryText}" FontSize="13.5" FontAttributes="Bold" TextColor="{DynamicResource InkColor}"
                                                       VerticalOptions="Center" IsVisible="{Binding HasExpiry}" />
                                                <Label Text="—" FontSize="13.5" TextColor="{DynamicResource TertiaryTextColor}"
                                                       VerticalOptions="Center" IsVisible="{Binding HasExpiry, Converter={StaticResource InvertedBoolConverter}}" />
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>

                                <!-- How much of the year is left, and the words for it. -->
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <ProgressBar Progress="{Binding ExpiryProgress}" Style="{StaticResource StateBar}" VerticalOptions="Center"
                                                 IsVisible="{Binding HasBar}" />
                                    <Label Grid.Column="1" Text="{Binding Detail}" FontSize="12.5" FontAttributes="Bold" Style="{StaticResource StateInk}" />
                                </Grid>

                                <Border Padding="12,9" StrokeThickness="0" StrokeShape="RoundRectangle 12" IsVisible="{Binding HasNote}"
                                        Style="{StaticResource StateSoft}">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                                        <Label Text="&#xf05a;" Style="{StaticResource StateInk}" FontFamily="FontAwesomeSolid" FontSize="13" VerticalOptions="Start" Margin="0,2,0,0" />
                                        <Label Grid.Column="1" Text="{Binding Note}" FontSize="13" TextColor="{DynamicResource InkColor}" />
                                    </Grid>
                                </Border>

                                <BoxView HeightRequest="1" Color="{DynamicResource SeparatorColor}" />

                                <!-- Actions, centred: View (a spinner while the file comes) and Upload / Renew. -->
                                <HorizontalStackLayout Spacing="12" HorizontalOptions="Center">
                                    <Border WidthRequest="136" HeightRequest="42" StrokeThickness="1.5" StrokeShape="RoundRectangle 21"
                                            Stroke="{DynamicResource BorderColor}" BackgroundColor="Transparent" IsVisible="{Binding CanView}">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:DocumentsViewModel}}, Path=ViewCommand}"
                                                                  CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <HorizontalStackLayout Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                                            <Label Text="&#xf06e;" Style="{StaticResource Glyph}" FontSize="14" TextColor="{DynamicResource InkColor}" IsVisible="{Binding IsIdle}" />
                                            <ActivityIndicator IsRunning="{Binding IsOpening}" IsVisible="{Binding IsOpening}" Color="{DynamicResource AccentColor}"
                                                               HeightRequest="18" WidthRequest="18" VerticalOptions="Center" />
                                            <Label Text="View" FontSize="14" FontAttributes="Bold" TextColor="{DynamicResource InkColor}" VerticalOptions="Center">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsOpening}" Value="True"><Setter Property="Text" Value="Opening…" /></DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </HorizontalStackLayout>
                                    </Border>
                                    <Border WidthRequest="136" HeightRequest="42" StrokeThickness="1.5" StrokeShape="RoundRectangle 21"
                                            Stroke="{DynamicResource AccentColor}" BackgroundColor="{DynamicResource AccentSoftColor}" IsVisible="{Binding CanUpload}">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:DocumentsViewModel}}, Path=OpenCommand}"
                                                                  CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <HorizontalStackLayout Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                                            <Label Text="{Binding ActionGlyph}" Style="{StaticResource Glyph}" FontSize="14" TextColor="{DynamicResource AccentColor}" />
                                            <Label Text="{Binding ActionText}" FontSize="14" FontAttributes="Bold" TextColor="{DynamicResource AccentColor}" VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                    </Border>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.Footer>
                <!-- Room to scroll the last card out from under the menu. -->
                <BoxView HeightRequest="110" Color="Transparent" />
            </CollectionView.Footer>
        </CollectionView>
    </RefreshView>
</ContentPage>
