<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Raphael.Driver.Views.SchedulePage"
             xmlns:viewmodels="clr-namespace:Raphael.Driver.ViewModels"
             xmlns:mct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:converters="clr-namespace:Raphael.Driver.Converters"
             xmlns:controls="clr-namespace:Raphael.Driver.Controls"
             Title="SCHEDULE">

    <Shell.TitleView>
        <controls:PageTitleBar Title="SCHEDULE" Icon="&#xf073;" ShowBell="False" >
            <controls:PageTitleBar.Accessory>
                <controls:CallRequestButton Compact="True" />
            </controls:PageTitleBar.Accessory>
        </controls:PageTitleBar><!-- RE-064: no bell (Alerts is in the menu); Call me sits in its place instead of floating over the cards -->
    </Shell.TitleView>

    <ContentPage.BindingContext>
        <viewmodels:ScheduleViewModel />
    </ContentPage.BindingContext>

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
        
    <ContentPage.Behaviors>
        <!-- No StatusBarBehavior: the status bar follows the theme (ThemeManager.ApplyStatusBar). -->
    </ContentPage.Behaviors>

    <Grid>
        
        <Image Source="map_background.png" 
               Aspect="AspectFill"
               Opacity="0.2"/>

        <VerticalStackLayout Padding="30,40" Spacing="20" 
                             VerticalOptions="Center" HorizontalOptions="FillAndExpand">
           
            <Image Source="{DynamicResource LogoImage}"
                   Aspect="AspectFit"
                   HeightRequest="190"
                   Margin="0,0,0,30"/>
           
            <Border StrokeShape="RoundRectangle 10" 
                    StrokeThickness="1" 
                    Stroke="{DynamicResource BorderColor}" 
                    BackgroundColor="{DynamicResource CardBackgroundColor}" 
                    Padding="15,0" 
                    HeightRequest="50">
                <Entry Placeholder="Run Login"
                       Text="{Binding RunLogin}"
                       VerticalTextAlignment="Center"
                       TextColor="{DynamicResource PrimaryTextColor}"
                        PlaceholderColor="{DynamicResource SecondaryTextColor}"
                       FontSize="16"/>
            </Border>
         
            <!--<Border StrokeShape="RoundRectangle 10"
                    StrokeThickness="1" 
                    Stroke="{DynamicResource BorderColor}" 
                    BackgroundColor="{DynamicResource SurfaceColor}" 
                    Padding="15,0" 
                    HeightRequest="50">
                <Entry Placeholder="Vehicle Login"
                       Text="{Binding VehicleLogin}"
                       VerticalTextAlignment="Center"
                       FontSize="16"/>
            </Border>-->

            <!-- Button Today's Schedule (Green) -->
            <Button Text="TODAY'S SCHEDULE"
                    Command="{Binding GoToTodayScheduleCommand}"
                    ImageSource="{FontImageSource FontFamily=FontAwesomeSolid, Glyph='&#xf017;', Color=White, Size=18}"
                    ContentLayout="Left, 10"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                    Style="{StaticResource PrimaryActionButtonStyle}"
                    HeightRequest="55"
                    CornerRadius="10"
                    FontSize="18"
                    FontAttributes="Bold"
                    Margin="0,20,0,0"/>

            <!-- Button Future Schedule (Blue) -->
            <Button Text="FUTURE SCHEDULE"
                    Command="{Binding GoToFutureScheduleCommand}"
                    ImageSource="{FontImageSource FontFamily=FontAwesomeSolid, Glyph='&#xf073;', Color=White, Size=18}"
                    ContentLayout="Left, 10"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    HeightRequest="55"
                    CornerRadius="10"
                    FontSize="18"
                    FontAttributes="Bold"/>
        </VerticalStackLayout>

        <ActivityIndicator IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           Color="{DynamicResource AccentColor}"
                           HeightRequest="50"
                           WidthRequest="50"/>

        
    </Grid>
</ContentPage>