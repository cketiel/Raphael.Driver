<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>samsara</string>
		<string>comgooglemaps</string>
		<string>waze</string>
	</array>
	<!-- Tells iOS that your app has special background capabilities. The location value is specific to location tracking.-->
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
	</array>
	
	<!-- Permission to access location when the app is in use -->
	<key>NSCameraUsageDescription</key>
	<string>The vehicle inspection takes a photo of every problem as evidence.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>We need your location to record and show your route on the map while you work.</string>
	
	<!-- Permission to access location always (including background) -->
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>This app needs continuous access to your location to accurately record your route, even if the app is in the background.</string>

	<!-- Xcode 27: UIKit requires the scene life cycle; without it the app closes after the splash. -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>__MAUI_DEFAULT_SCENE_CONFIGURATION__</string>
					<key>UISceneDelegateClassName</key>
					<string>SceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>

	<!-- Only HTTPS/TLS from the OS: exempt, so App Store Connect does not ask on every upload. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIDeviceFamily</key>
	<array>
		<integer>1</integer>
		<integer>2</integer>
	</array>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>XSAppIconAssets</key>
	<string>Assets.xcassets/appicon.appiconset</string>
</dict>
</plist>
