<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.raphael.driver">

	<!-- PERMISSIONS -->
	<uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
	<uses-permission android:name="android.permission.INTERNET" />
	<uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
	<uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
	
	<!-- Generic permission for foreground services -->
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
	
	<!-- THE SPECIFIC PERMISSION REQUIRED -->
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

	<!-- Permission for notifications in Android 13+ -->
	<uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
	<!-- RE-062: the vehicle inspection takes a photo of every problem, with the camera only. -->
	<uses-permission android:name="android.permission.CAMERA" />
	<uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
		
	<application
		android:allowBackup="true"
		android:icon="@mipmap/appicon"
		android:supportsRtl="true"
		android:usesCleartextTraffic="true"
		android:label="Raphael.Driver">

		<!-- Channel a push lands on when it does not name one. Must match the id created in
		     RaphaelFirebaseMessagingService, or Android drops the notice on a channel the
		     user has never seen and cannot configure. -->
		<meta-data
			android:name="com.google.firebase.messaging.default_notification_channel_id"
			android:value="raphael_driver_notifications" />

		<!-- ⚠️ This is the icon that actually matters most of the time. When a push carries a
		     notification block and the app is in the background, the Firebase SDK draws the
		     notification itself and never calls OnMessageReceived, so whatever the code sets
		     is irrelevant. Without this line Android falls back to the launcher icon, and
		     because it renders the small icon from its alpha channel alone, a full colour
		     launcher icon comes out as a solid white square. ic_stat_notification is the
		     white-on-transparent silhouette. -->
		<meta-data
			android:name="com.google.firebase.messaging.default_notification_icon"
			android:resource="@drawable/ic_stat_notification" />

		<meta-data
			android:name="com.google.firebase.messaging.default_notification_color"
			android:resource="@color/raphael_notification_color" />

	</application>
	
	<queries>
		<!-- RE-062: MediaPicker.CapturePhotoAsync opens the phone's camera app. -->
		<intent>
			<action android:name="android.media.action.IMAGE_CAPTURE" />
		</intent>
		<intent>
			<action android:name="android.intent.action.VIEW" />
			<data android:scheme="sms" />
		</intent>
		<intent>
			<action android:name="android.intent.action.VIEW" />
			<data android:scheme="waze" />
		</intent>
		<intent>
			<action android:name="android.intent.action.VIEW" />
			<data android:scheme="google.navigation" />
		</intent>
		<package android:name="com.waze" />
		<package android:name="com.google.android.apps.maps" />
		<!-- Permission to detect the Samsara app -->
		<package android:name="com.samsara.driver" />
	</queries>

</manifest>