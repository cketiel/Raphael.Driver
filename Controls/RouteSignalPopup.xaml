<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               x:Class="Raphael.Driver.Controls.RouteSignalPopup"
               CanBeDismissedByTappingOutsideOfPopup="False"
               Color="Transparent">

    <!--
        Blocking on purpose, and self-resolving on purpose.

        Refreshing the schedule the instant a signal arrives reorders the list under the
        driver's thumb: they meant to press Arrive on one event and press it on another
        patient's. Requiring a tap is no better — they are driving, and until they touch the
        phone the app sits there showing a schedule we already know is wrong.

        So: the list underneath cannot be touched, the driver has a few seconds to read, and
        the refresh happens whether or not they do anything.
    -->
    <Border BackgroundColor="{StaticResource SurfaceColor}"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 14"
            Padding="22"
            WidthRequest="320">

        <VerticalStackLayout Spacing="14">

            <Label x:Name="TitleLabel"
                   Text="Route updated"
                   TextColor="{StaticResource InkColor}"
                   FontSize="19"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center" />

            <Label x:Name="MessageLabel"
                   TextColor="{StaticResource PrimaryTextColor}"
                   FontSize="15"
                   HorizontalTextAlignment="Center" />

            <Label x:Name="CountdownLabel"
                   TextColor="{StaticResource SecondaryTextColor}"
                   FontSize="13"
                   HorizontalTextAlignment="Center" />

            <Button x:Name="ActionButton"
                    Text="Refresh now"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="{StaticResource OnBrandTextColor}"
                    CornerRadius="8"
                    Clicked="OnActionClicked" />

        </VerticalStackLayout>
    </Border>
</toolkit:Popup>
